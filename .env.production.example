# Public frontend URLs (safe to commit)
VITE_API_URL=https://api.yourdomain.com/api
VITE_PUBLIC_SITE_URL=https://yourdomain.com
VITE_APP_DOMAIN=yourdomain.com
VITE_ADMIN_DOMAIN=admin.yourdomain.com

# NEVER commit real secrets
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
VITE_STRIPE_PUBLIC_KEY=pk_live_REPLACE_ME
DATABASE_URL=postgres://user:password@host:5432/dbname
SESSION_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=REPLACE_ME

# --- Card checkout / fulfillment safety ---
# Stripe webhook signing secret (REQUIRED for Stripe fulfillment; webhook is
# rejected if unset).
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Provider (Fluz) webhook HMAC secret. REQUIRED: without it the provider webhook
# returns 503 and no provider payment can be fulfilled. Signature verification
# now runs BEFORE anything is persisted, so an unsigned call is rejected outright.
FLUZ_WEBHOOK_SECRET=REPLACE_ME
# KYC is ALWAYS mandatory for card checkout in production. Outside production,
# set to 'true' to require it there too.
REQUIRE_KYC_FOR_CARD_CHECKOUT=true
# Stablecoin (USDT) fulfillment from card funds is DISABLED unless set to the
# exact string 'true'. Leave unset/false unless crypto fulfillment is legally
# approved with the required licensing and provider agreements.
# ENABLE_STABLECOIN_FULFILLMENT=false

# --- CORS ---
# REQUIRED in production. Comma-separated list of the exact public origins
# allowed to make credentialed browser requests. Bare domains are treated as
# https://. Loopback origins are NOT allowed in production, and an http:// entry
# is dropped, so leaving this unset yields an EMPTY allowlist and every
# cross-origin browser call is refused (the server logs a warning at boot).
REPLIT_DOMAINS=yourdomain.com,www.yourdomain.com

# --- MCP administrative server (scripts/npm run mcp:http) ---
# REQUIRED. The MCP server refuses to start without these.
# MCP_SECRET must be at least 32 chars and MUST NOT equal SESSION_SECRET:
# sharing them would let any ordinary end-user auth_token authenticate as an
# MCP client. Generate with: openssl rand -hex 32
# The "must differ from SESSION_SECRET" check is best-effort: it can only fire
# when SESSION_SECRET is also present in the MCP process's environment. If you
# run the MCP server standalone, verify the distinctness yourself.
MCP_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_DISTINCT_FROM_SESSION_SECRET
MCP_API_KEY=REPLACE_ME
# Bind address for the MCP server. Keep it on loopback — it is an
# administrative surface (filesystem read, optional read-only SQL).
# MCP_BIND_HOST=127.0.0.1
# Raw read-only SELECT over the MCP surface. Leave unset unless needed.
# MCP_ENABLE_RAW_SQL=false

# --- AI assistant spend control ---
# Max AI messages per user per UTC calendar day. Defaults to 100 if unset.
# Set to 0 to disable the AI assistant entirely.
# NOTE: a unit is consumed when the message is accepted, before the model
# responds. If the client disconnects mid-stream the unit is still spent — this
# is deliberate, so an abort cannot be used to get unmetered generations.
# AI_DAILY_MESSAGE_LIMIT=100
